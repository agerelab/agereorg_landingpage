# Public base URL: robots.txt, sitemap.xml and links in early bird emails.
# Defaults to the request's own origin. Production: https://www.agereorg.com
# APP_URL=http://localhost:3000

# Outgoing email through Resend (PRD-00 D114). Leave both empty locally: messages are written to the
# server log instead. In production the early bird form refuses to "send" without them.
# EMAIL_FROM uses the verified sending subdomain, e.g. "agere/org <noreply@mail.agereorg.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Inbox that receives early bird applications (FE-18); defaults to the team inbox.
# EARLY_BIRD_INBOX=

# Seals the "Undang ke panggilan" / "Tolak" links in the team email (early bird decision page).
# Without it the team email carries no decision links. Generate with: openssl rand -base64 32
EARLY_BIRD_SECRET=

# Booking page for the 30-minute intro call, linked in the invitation email (https:// only).
# EARLY_BIRD_BOOKING_URL=
